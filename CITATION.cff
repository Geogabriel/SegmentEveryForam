    family-names: Ojo
    orcid: "https://orcid.org/0000-0001-7956-9125"
    affiliation: "Institute for Geophysics, Jackson School of Geosciences, The University of Texas at Austin"
version: 0.1.0
date-released: "2026-11-25"
license: Apache-2.0
repository-code: "https://github.com/Geogabriel/SegmentEveryForam"
keywords:
  - foraminifera
  - micropaleontology
  - image segmentation
  - morphometrics
  - U-Net
  - Segment Anything Model
